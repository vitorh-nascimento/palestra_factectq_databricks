{
  "datasets": [
    {
      "name": "vendas_por_hora",
      "displayName": "Vendas por Hora",
      "queryLines": [
        "SELECT ",
        "    HOUR(dateTime) AS hora, ",
        "    COUNT(*) AS vendas ",
        "FROM samples.bakehouse.sales_transactions ",
        "GROUP BY hora ",
        "ORDER BY hora;"
      ]
    },
    {
      "name": "top_franquias",
      "displayName": "Franquias Campeãs",
      "queryLines": [
        "SELECT ",
        "    f.name AS franquia, ",
        "    f.city AS cidade, ",
        "    f.country AS pais, ",
        "    ROUND(SUM(t.totalPrice), 2) AS faturamento ",
        "FROM samples.bakehouse.sales_transactions t ",
        "JOIN samples.bakehouse.sales_franchises f ",
        "  ON t.franchiseID = f.franchiseID ",
        "GROUP BY f.name, f.city, f.country ",
        "ORDER BY faturamento DESC ",
        "LIMIT 5;"
      ]
    },
    {
      "name": "produtos_mais_vendidos",
      "displayName": "Top Cookies",
      "queryLines": [
        "SELECT ",
        "    product, ",
        "    SUM(quantity) AS total_unidades ",
        "FROM samples.bakehouse.sales_transactions ",
        "GROUP BY product ",
        "ORDER BY total_unidades DESC ",
        "LIMIT 5;"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "CSI Cookie - Visão Executiva",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "header_title",
            "multilineTextboxSpec": {
              "lines": [
                "# CSI Cookie - Visão Executiva\n",
                "\n",
                "Painel executivo com métricas de vendas, franquias e produtos da rede Bakehouse."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "chart_vendas_por_hora",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "vendas_por_hora",
                  "fields": [
                    {
                      "name": "hora",
                      "expression": "`hora`"
                    },
                    {
                      "name": "vendas",
                      "expression": "`vendas`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "hora",
                  "displayName": "Hora do Dia",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "vendas",
                  "displayName": "Vendas",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "title": "Distribuição de Vendas por Hora do Dia",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 12,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "chart_top_franquias",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "top_franquias",
                  "fields": [
                    {
                      "name": "franquia",
                      "expression": "`franquia`"
                    },
                    {
                      "name": "faturamento",
                      "expression": "`faturamento`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "faturamento",
                  "displayName": "Faturamento ($)",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "y": {
                  "fieldName": "franquia",
                  "displayName": "Franquia",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "x-reversed"
                    }
                  }
                }
              },
              "frame": {
                "title": "Top 5 Franquias por Faturamento",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 8,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "chart_produtos_mais_vendidos",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "produtos_mais_vendidos",
                  "fields": [
                    {
                      "name": "product",
                      "expression": "`product`"
                    },
                    {
                      "name": "total_unidades",
                      "expression": "`total_unidades`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "total_unidades",
                  "displayName": "Unidades Vendidas",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "y": {
                  "fieldName": "product",
                  "displayName": "Sabor do Cookie",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "x-reversed"
                    }
                  }
                }
              },
              "frame": {
                "title": "Top 5 Cookies Mais Vendidos",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 6,
            "y": 8,
            "width": 6,
            "height": 6
          }
        }
      ]
    }
  ]
}
