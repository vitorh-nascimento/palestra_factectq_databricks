        "question": ["Qual franquia vendeu mais?"]
      },
      {
        "id": "10000000000000000000000000000002",
        "question": ["Qual o sabor de cookie mais vendido?"]
      },
      {
        "id": "10000000000000000000000000000003",
        "question": ["Qual o faturamento total por país?"]
      },
      {
        "id": "10000000000000000000000000000004",
        "question": ["Qual bandeira de cartão é a mais usada nas compras?"]
      }
    ]
  },
  "data_sources": {
    "tables": [
      {
        "identifier": "samples.bakehouse.sales_customers",
        "column_configs": [
          {
            "column_name": "address",
            "description": ["Endereço do cliente (Dado PII protegido pela LGPD)."]
          },
          {
            "column_name": "customerID",
            "description": ["Identificador único do cliente."]
          },
          {
            "column_name": "email_address",
            "description": ["E-mail do cliente (Dado PII protegido pela LGPD)."]
          },
          {
            "column_name": "name",
            "description": ["Nome completo do cliente."],
            "enable_entity_matching": true,
            "synonyms": ["cliente", "consumidor"]
          },
          {
            "column_name": "phone_number",
            "description": ["Número de telefone do cliente (Dado PII)."]
          }
        ]
      },
      {
        "identifier": "samples.bakehouse.sales_franchises",
        "column_configs": [
          {
            "column_name": "city",
            "description": ["Cidade onde a franquia está instalada."],
            "enable_entity_matching": true,
            "enable_format_assistance": true,
            "synonyms": ["município", "cidade"]
          },
          {
            "column_name": "country",
            "description": ["País da unidade da franquia."],
            "enable_entity_matching": true,
            "enable_format_assistance": true,
            "synonyms": ["país", "nação"]
          },
          {
            "column_name": "franchiseID",
            "description": ["Identificador chave da franquia."]
          },
          {
            "column_name": "name",
            "description": ["Nome fantasia da loja ou franquia."],
            "enable_entity_matching": true,
            "enable_format_assistance": true,
            "synonyms": ["loja", "franquia", "unidade"]
          }
        ]
      },
      {
        "identifier": "samples.bakehouse.sales_transactions",
        "column_configs": [
          {
            "column_name": "cardNumber",
            "description": ["Número mascarado do cartão de crédito."]
          },
          {
            "column_name": "cardType",
            "description": ["Bandeira do cartão usado (Visa, Mastercard, Amex)."],
            "enable_entity_matching": true,
            "enable_format_assistance": true,
            "synonyms": ["bandeira", "forma de pagamento", "cartão"]
          },
          {
            "column_name": "customerID",
            "description": ["Identificador do cliente que realizou a compra."]
          },
          {
            "column_name": "dateTime",
            "description": ["Data e hora da transação de venda."],
            "synonyms": ["data", "horário", "quando"]
          },
          {
            "column_name": "franchiseID",
            "description": ["Identificador da loja onde ocorreu a venda."]
          },
          {
            "column_name": "product",
            "description": ["Nome do sabor de cookie comprado."],
            "enable_entity_matching": true,
            "enable_format_assistance": true,
