          },
          {
            "column_name": "quantity",
            "description": ["Quantidade de cookies vendidos na transação."],
            "synonyms": ["unidades", "volume", "quantidade"]
          },
          {
            "column_name": "totalPrice",
            "description": ["Valor monetário total da transação em dólares."],
            "synonyms": ["faturamento", "receita", "valor", "preço total"]
          },
          {
            "column_name": "transactionID",
            "description": ["Identificador único da transação de venda."]
          }
        ]
      }
    ]
  },
  "instructions": {
    "example_question_sqls": [
      {
        "id": "20000000000000000000000000000001",
        "question": ["Qual franquia vendeu mais?"],
        "sql": [
          "SELECT f.name, ROUND(SUM(t.totalPrice), 2) AS total_faturamento FROM samples.bakehouse.sales_transactions t JOIN samples.bakehouse.sales_franchises f ON t.franchiseID = f.franchiseID GROUP BY f.name ORDER BY total_faturamento DESC LIMIT 1"
        ]
      },
      {
        "id": "20000000000000000000000000000002",
        "question": ["Qual sabor de cookie mais vendido?"],
        "sql": [
          "SELECT product, SUM(quantity) AS total_unidades FROM samples.bakehouse.sales_transactions GROUP BY product ORDER BY total_unidades DESC LIMIT 5"
        ]
      },
      {
        "id": "20000000000000000000000000000003",
        "question": ["Qual o faturamento por país?"],
        "sql": [
          "SELECT f.country, ROUND(SUM(t.totalPrice), 2) AS faturamento FROM samples.bakehouse.sales_transactions t JOIN samples.bakehouse.sales_franchises f ON t.franchiseID = f.franchiseID GROUP BY f.country ORDER BY faturamento DESC"
        ]
      }
    ],
    "join_specs": [
      {
        "id": "20000000000000000000000000000004",
        "left": {
          "identifier": "samples.bakehouse.sales_transactions",
          "alias": "sales_transactions"
        },
        "right": {
          "identifier": "samples.bakehouse.sales_franchises",
          "alias": "sales_franchises"
        },
        "sql": [
          "sales_transactions.`franchiseID` = sales_franchises.`franchiseID`",
          "--rt=FROM_RELATIONSHIP_TYPE_MANY_TO_ONE--"
        ]
      }
    ],
    "sql_snippets": {
      "measures": [
        {
          "alias": "faturamento_total",
          "display_name": "Faturamento Total",
          "id": "20000000000000000000000000000005",
          "sql": ["ROUND(SUM(sales_transactions.`totalPrice`), 2)"],
          "synonyms": ["receita", "total vendido", "faturamento"]
        },
        {
          "alias": "quantidade_total",
          "display_name": "Volume de Cookies",
          "id": "20000000000000000000000000000006",
          "sql": ["SUM(sales_transactions.`quantity`)"],
          "synonyms": ["unidades vendidas", "volume"]
        }
      ]
    },
    "text_instructions": [
      {
        "content": [
          "Para perguntas sobre faturamento, receita ou valor financeiro, sempre use SUM(sales_transactions.totalPrice).",
          "Para perguntas sobre volume de vendas ou unidades de cookies, use SUM(sales_transactions.quantity).",
          "Para relacionar vendas às cidades ou nomes de lojas, sempre faça JOIN com samples.bakehouse.sales_franchises usando a coluna franchiseID."
        ],
        "id": "30000000000000000000000000000001"
      }
    ]
  }
}

